# Rogue Backend Environment Configuration Example

# Server Port (defaults to 3001)
PORT=3001

# Node Environment
NODE_ENV=production

# Database Connection (PostgreSQL - Supabase / Neon / Render Postgres)
# Leave blank to fall back to in-memory Mock Database
DATABASE_URL=postgresql://user:password@host:6543/postgres

# JWT Secret Key (Change to a strong random string in production)
JWT_SECRET=your_production_jwt_secret_key_here

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# CORS & Domain Redirects
FRONTEND_URL=https://rogue-campus.vercel.app,http://localhost:3000
BACKEND_URL=https://rogue-api.onrender.com
